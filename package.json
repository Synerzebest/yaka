{
  "name": "yaka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs}\"",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && node scripts/generate-curriculum-sql.mjs --check",
    "sql:curriculum": "node scripts/generate-curriculum-sql.mjs",
    "test:db": "python3 scripts/test-database.py",
    "test:supabase": "node --env-file=.env.local --experimental-strip-types scripts/test-supabase.mjs",
    "check:legal": "node scripts/check-legal.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
