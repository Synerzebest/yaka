# Connexion Supabase : authentification, profil et lecture des leçons.
# Sans ces variables, le mode découverte local reste disponible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète Supabase nécessaire à la génération et à la correction serveur.
# Stripe reste à connecter.
# Secrets : ne jamais utiliser le préfixe NEXT_PUBLIC_ pour ces valeurs.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Adresse publique du site, utilisée dans les liens envoyés par e-mail aux parents.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Envoi des demandes d'autorisation parentale (API Resend). Sans clé, en développement,
# l'e-mail est affiché dans le terminal ; en production, la demande est refusée.
RESEND_API_KEY=
EMAIL_FROM=Yaka <contact@yakamaths.be>
